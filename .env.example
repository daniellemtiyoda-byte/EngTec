# Copie para .env.local e ajuste. NUNCA coloque senhas, chaves ou credenciais da fornecedora aqui:
# tudo que começa com VITE_ é embutido no JavaScript enviado ao navegador.

# URL base do back-end (sem barra no final). Informada pelo responsável pelo back-end.
VITE_API_URL=

# "true" = serviços simulados (dados fictícios identificados na tela). "false" = API real.
VITE_USE_MOCK=true

# Arquivo do logo do Holz Trilho (veja public/assets/LEIA-ME.txt); sem ele aparece o monograma "HT"
VITE_LOGO_URL=/assets/logo.svg

# Limite de upload no navegador (o servidor deve validar novamente)
VITE_UPLOAD_MAX_MB=10

# Base do link gravado nos QR code: a URL da Vercel, com https e sem barra no fim (ex.: https://holz-trilho.vercel.app).
# Vazia: usa o endereço em que o app está aberto, que não abre no celular. Configure antes de imprimir etiquetas.
VITE_APP_URL=
