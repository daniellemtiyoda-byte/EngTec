# Copie para .env.local e ajuste. NUNCA coloque senhas nem chaves secretas aqui: tudo que começa com VITE_ é
# embutido no JavaScript enviado ao navegador. A chave service_role e a senha do banco do Supabase NUNCA entram
# aqui nem no repositório (a chave anon é pública: quem controla o acesso são as políticas e as funções do banco).

# Fonte dos dados e do login: "supabase" (banco e Supabase Auth) ou "mock" (modo simulado, dados no navegador).
# Sem a variável, o app usa o modo simulado.
VITE_FONTE_DADOS=mock

# Projeto do Supabase (Settings › API): a URL e a chave pública "anon". Só usadas com VITE_FONTE_DADOS=supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Arquivo do logo do Holz Trilho (veja public/assets/LEIA-ME.txt); sem ele aparece o monograma "HT"
VITE_LOGO_URL=/assets/logo.svg

# Limite de upload no navegador (o bucket do Supabase também limita a 10 MB)
VITE_UPLOAD_MAX_MB=10

# Base do link gravado nos QR code: a URL da Vercel, com https e sem barra no fim (já configurada lá).
# Vazia: usa o endereço em que o app está aberto (no computador, localhost, que não abre no celular).
VITE_APP_URL=https://holz-trilho.vercel.app
